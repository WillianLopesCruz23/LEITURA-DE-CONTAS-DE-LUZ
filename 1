      {wch:9},{wch:10},{wch:10},{wch:9},{wch:11},{wch:11},{wch:13}
    ];
    XLSX.utils.book_append_sheet(wb, ws, String(code).substring(0, 31));
  });

  XLSX.writeFile(wb, `ConsEn_HV_${ano}.xlsx`);
}

