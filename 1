const MESES_LISTA = ["JAN","FEV","MAR","ABR","MAIO","JUN","JUL","AGO","SET","OUT","NOV","DEZ"];
const MESES_ABAS  = ["jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"];
const MAP_MES_NUM = {
  "01":"JAN","02":"FEV","03":"MAR","04":"ABR","05":"MAIO","06":"JUN",
  "07":"JUL","08":"AGO","09":"SET","10":"OUT","11":"NOV","12":"DEZ"
};
const MAP_MES_TXT = {
  "jan":"JAN","fev":"FEV","mar":"MAR","abr":"ABR","mai":"MAIO","maio":"MAIO",
  "jun":"JUN","jul":"JUL","ago":"AGO","set":"SET","out":"OUT","nov":"NOV","dez":"DEZ"
};

let invoices = [];

function logMsg(msg) {
  const box = document.getElementById('logBox');
  box.innerHTML = `<div>• ${msg}</div>` + box.innerHTML;
}

function parseBRNumber(str) {
  if (!str) return 0;
  let s = String(str).replace(/\s+/g, '').replace('R$', '');
  // Se tiver vírgula e ponto, ponto é milhar e vírgula é decimal
  if (s.includes(',') && s.includes('.')) {
    s = s.replace(/\./g, '').replace(',', '.');
  } else if (s.includes(',')) {
    s = s.replace(',', '.');
  }
  const n = parseFloat(s);
  return isNaN(n) ? 0 : Math.round(n * 100) / 100;
}

// Drag & Drop handlers
const dropzone = document.getElementById('dropzone');
const fileInput = document.getElementById('fileInput');
dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('dragover'); });
dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
dropzone.addEventListener('drop', e => {
  e.preventDefault();
  dropzone.classList.remove('dragover');
  if (e.dataTransfer.files.length) handleFiles(e.dataTransfer.files);
});
fileInput.addEventListener('change', e => {
  if (e.target.files.length) handleFiles(e.target.files);
  fileInput.value = '';
});

async function handleFiles(fileList) {
  for (const file of fileList) {
    if (!file.name.toLowerCase().endsWith('.pdf')) {
      logMsg(`Ignorado (não é PDF): ${file.name}`);
      continue;
    }
    try {
      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      let fullText = '';
      for (let p = 1; p <= pdf.numPages; p++) {
        const page = await pdf.getPage(p);
        const content = await page.getTextContent();
        const pageText = content.items.map(i => i.str).join(' ');
        fullText += '\n' + pageText;
      }
      const parsed = parseCeeeInvoice(fullText, file.name);
      // Substitui se já existir mesmo código + mês + ano
      const existingIdx = invoices.findIndex(x => x.codigo === parsed.codigo && x.mes === parsed.mes && x.ano === parsed.ano);
      if (existingIdx >= 0) invoices[existingIdx] = parsed;
      else invoices.push(parsed);

      logMsg(`Lido com sucesso: <b>${file.name}</b> → Estação <b>${parsed.codigo}</b> (${parsed.mes}/${parsed.ano}) — Total R$ ${parsed.totalFatura.toFixed(2)}`);
    } catch (err) {
      console.error(err);
      logMsg(`Erro ao ler ${file.name}: ${err.message}`);
    }
  }
  renderTable();
}

function parseCeeeInvoice(text, fileName) {
  const clean = text.replace(/\s+/g, ' ');

  // 1. Extrair código e mês/ano do nome do arquivo (ex: 6102-out25.pdf)
  let codeFromFile = '';
  let mesFromFile = '';
  let anoFromFile = '';
  const fnMatch = fileName.match(/^(\d+[A-Z0-9]*)\s*[-_]\s*([a-zA-ZçÇ]{3,4})(\d{2,4})/i);
  if (fnMatch) {
    codeFromFile = fnMatch[1].toUpperCase();
    const mKey = fnMatch[2].toLowerCase();
    mesFromFile = MAP_MES_TXT[mKey] || '';
    anoFromFile = fnMatch[3].length === 2 ? '20' + fnMatch[3] : fnMatch[3];
  }

  // 2. Extrair Número da UC do texto
  let ucFound = '';
  const ucMatch = clean.match(/N[úu]mero\s+da\s+UC\s+(\d{6,12})/i);
  if (ucMatch) ucFound = ucMatch[1];

  // 3. Vincular com o catálogo DMAE (por código do arquivo ou UC do PDF)
  let station = null;
  if (codeFromFile) {
    station = STATIONS_CATALOG.find(s => s.codigo.toUpperCase() === codeFromFile);
  }
  if (!station && ucFound) {
    station = STATIONS_CATALOG.find(s => s.uc_clean === ucFound || s.uc_clean.startsWith(ucFound));
  }

  const codigo = station ? station.codigo : (codeFromFile || 'S/C');
  const local = station ? station.local : (codeFromFile ? `${codeFromFile}-Estação DMAE` : 'Estação não identificada');
  const ucFormatted = station ? station.uc : ucFound;

  // 4. Conta mês (MM/YYYY)
  let mes = mesFromFile || 'OUT';
  let ano = anoFromFile || document.getElementById('anoRef').value;
  const contaMesMatch = clean.match(/Conta\s+m[êe]s\s+(\d{2})\/(\d{4})/i);
  if (contaMesMatch) {
    mes = MAP_MES_NUM[contaMesMatch[1]] || mes;
    ano = contaMesMatch[2];
  }

  // 5. Período de Leitura (Leitura Anterior DD/MM/YYYY Leitura Atual DD/MM/YYYY)
  let periodo = '';
  const leitMatch = clean.match(/Leitura\s+Anterior\s+(\d{2}\/\d{2})\/\d{4}\s+Leitura\s+Atual\s+(\d{2}\/\d{2})\/\d{4}/i)
                 || clean.match(/(\d{2}\/\d{2})\/\d{4}\s+(\d{2}\/\d{2})\/\d{4}\s+\d{2}\s+\d{2}\/\d{2}\/\d{4}/);
  if (leitMatch) {
    periodo = `${leitMatch[1]}-${leitMatch[2]}`;
  }

  // 6. Extrair itens da fatura
  function matchItemVal(regex) {
    const m = clean.match(regex);
    return m ? parseBRNumber(m[1]) : 0;
  }
  function matchItemQtyAndVal(regex) {
    const m = clean.match(regex);
    if (!m) return { qty: 0, val: 0 };
    return { qty: parseBRNumber(m[1]), val: parseBRNumber(m[2]) };
  }

  // Consumo Ponta (TUSD + TE)
  const ptTusd = matchItemQtyAndVal(/TUSD\s+ENERGIA\s+PONTA\s+TUSD\s+kWh\s+([\d.,]+)\s+[\d.,]+\s+([\d.,]+)/i);
  const ptTe   = matchItemQtyAndVal(/TUSD\s+ENERGIA\s+PONTA\s+TE\s+kWh\s+([\d.,]+)\s+[\d.,]+\s+([\d.,]+)/i);
  const consPontaKwh = ptTusd.qty || ptTe.qty;
  const consPontaRs  = Math.round((ptTusd.val + ptTe.val) * 100) / 100;

  // Consumo Fora Ponta (TUSD + TE)
  const fpTusd = matchItemQtyAndVal(/TUSD\s+ENERGIA\s+FORA\s+DE\s+PONTA\s+TUSD\s+kWh\s+([\d.,]+)\s+[\d.,]+\s+([\d.,]+)/i);
  const fpTe   = matchItemQtyAndVal(/TUSD\s+ENERGIA\s+FORA\s+DE\s+PONTA\s+TE\s+kWh\s+([\d.,]+)\s+[\d.,]+\s+([\d.,]+)/i);
  const consFpKwh = fpTusd.qty || fpTe.qty;
  const consFpRs  = Math.round((fpTusd.val + fpTe.val) * 100) / 100;

  // Demanda (R$) = DEMANDA DE TUSD + DEMANDA DE TUSD ISENTA ICMS
  const demTusd   = matchItemQtyAndVal(/DEMANDA\s+DE\s+TUSD\s+KW\s+([\d.,]+)\s+[\d.,]+\s+([\d.,]+)/i);
  const demIsenta = matchItemQtyAndVal(/DEMANDA\s+DE\s+TUSD\s+ISENTA\s+ICMS\s+KW\s+([\d.,]+)\s+[\d.,]+\s+([\d.,]+)/i);
  const demandaRs = Math.round((demTusd.val + demIsenta.val) * 100) / 100;

  // Demanda kW Ponta e Fora Ponta (Resumo / Histórico)
  let demPontaKw = 0, demFpKw = 0;
  const demMaxFp = clean.match(/Dem\.\s*M[áa]x\.?\s*F\.?\s*Ponta\s*\(KW\):\s*([\d.,]+)/i);
  const demMaxPt = clean.match(/Dem\.\s*M[áa]x\.?\s*Ponta\s*\(KW\):\s*([\d.,]+)/i);
  if (demMaxFp) demFpKw = parseBRNumber(demMaxFp[1]);
  if (demMaxPt) demPontaKw = parseBRNumber(demMaxPt[1]);
  if (!demFpKw) demFpKw = Math.max(demTusd.qty, demIsenta.qty);

  // Reativo Excedente
  const reatFp = matchItemVal(/CONSUMO\s+REAT\.?\s*FORA\s+PONTA\s+TE\s+kvarh\s+[\d.,]+\s+[\d.,]+\s+([\d.,]+)/i);
  const reatPt = matchItemVal(/CONSUMO\s+REAT\.?\s*PONTA\s+TE\s+kvarh\s+[\d.,]+\s+[\d.,]+\s+([\d.,]+)/i);
  const reativoRs = Math.round((reatFp + reatPt) * 100) / 100;

  // Escassez Hídrica / Bandeira
  const escassez = matchItemVal(/ESCASSEZ\s+HIDRICA[^\d]+kWh\s+[\d.,]+\s+[\d.,]+\s+([\d.,]+)/i);
  const bandeira = matchItemVal(/ADICIONAL\s+BANDEIRA[^\d]+kWh\s+[\d.,]+\s+[\d.,]+\s+([\d.,]+)/i);

  // Subsídios Tarifários (Brutos na coluna Outros, Líquidos na coluna Créditos, conforme padrão da planilha DMAE)
  const subIsentaBruto = matchItemVal(/SUBSIDIO\s+TARIFARIO\s+DEM\s+ISENTA\s+TUSD\s+UN\s+[\d.,]+\s+[\d.,]+\s+([\d.,]+)/i);
  const subTusdBruto   = matchItemVal(/SUBSIDIO\s+TARIFARIO\s+TUSD\s+UN\s+[\d.,]+\s+[\d.,]+\s+([\d.,]+)/i);
  const outrosRs = Math.round((subIsentaBruto + subTusdBruto + escassez) * 100) / 100;

  const subLiq1 = Math.abs(matchItemVal(/SUBSIDIO\s+TARIFARIO\s+LIQUIDO\s+(-?[\d.,]+)/i));
  const subLiq2 = Math.abs(matchItemVal(/SUBSIDIO\s+TARIFARIO\s+LIQDO\s+DEM\s+ISENTA\s+(-?[\d.,]+)/i));
  const irpj1   = Math.abs(matchItemVal(/IMP\.RET\.\s*IRPJ\s*\(1,20%\)\s+(-?[\d.,]+)/i));
  const irpj2   = Math.abs(matchItemVal(/IMP\.RET\.\s*IRPJ\s*\(4,80%\)\s+(-?[\d.,]+)/i));
  const creditosRs = Math.round((subLiq1 + subLiq2 + irpj1 + irpj2) * 100) / 100;

  // CIP Municipal (Iluminação Pública)
  const cipRs = matchItemVal(/CIP\s+MUNICIPAL\s+([\d.,]+)/i);

  // Total a pagar
  let totalFatura = matchItemVal(/Total\s+a\s+pagar\s+R\$\s*([\d.,]+)/i);
  if (!totalFatura) totalFatura = matchItemVal(/TOTAL\s+([\d.,]+)\s+Grandezas/i);

  return {
    fileName,
    codigo,
    local,
    uc: ucFormatted,
    mes,
    ano,
    periodo,
    demPontaKw,
    demFpKw,
    demConvKw: Math.max(demPontaKw, demFpKw),
    demandaRs,
    consPontaKwh,
    consFpKwh,
    consTotalKwh: Math.round((consPontaKwh + consFpKwh) * 100) / 100,
    consPontaRs,
    consFpRs,
    consTotalRs: Math.round((consPontaRs + consFpRs) * 100) / 100,
    reativoRs,
    cipRs,
    bandeiraRs: bandeira,
    outrosRs,
    creditosRs,
    totalFatura
  };
}

function updateField(idx, field, val) {
  if (['codigo','local','uc','mes','ano','periodo'].includes(field)) {
    invoices[idx][field] = val.trim();
  } else {
    invoices[idx][field] = parseBRNumber(val);
    // Recalcula totais derivados
    invoices[idx].demConvKw = Math.max(invoices[idx].demPontaKw, invoices[idx].demFpKw);
    invoices[idx].consTotalKwh = Math.round((invoices[idx].consPontaKwh + invoices[idx].consFpKwh) * 100) / 100;
    invoices[idx].consTotalRs  = Math.round((invoices[idx].consPontaRs + invoices[idx].consFpRs) * 100) / 100;
  }
  renderTable();
}

function removeRow(idx) {
  invoices.splice(idx, 1);
  renderTable();
}

function clearAll() {
  invoices = [];
  renderTable();
  logMsg('Lista limpa.');
}

function renderTable() {
  const tbody = document.getElementById('tbody');
  const filtro = document.getElementById('filtroMes').value;
  const list = invoices
    .map((item, idx) => ({ item, idx }))
    .filter(({ item }) => filtro === 'TODOS' || item.mes === filtro);

  document.getElementById('countBadge').textContent = `${invoices.length} fatura(s) carregada(s)`;
  const soma = invoices.reduce((acc, x) => acc + (x.totalFatura || 0), 0);
  document.getElementById('totalBadge').textContent = `Total Geral: R$ ${soma.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;

  if (!list.length) {
    tbody.innerHTML = `<tr><td colspan="22" style="text-align:center; padding:24px; color:#64748b;">Nenhum registro para exibir.</td></tr>`;
    return;
  }

  tbody.innerHTML = list.map(({ item, idx }) => `
    <tr>
      <td title="${item.fileName}">${item.fileName}</td>
      <td><input class="code" value="${item.codigo}" onchange="updateField(${idx},'codigo',this.value)" /></td>
      <td><input class="txt" style="width:160px" value="${item.local}" onchange="updateField(${idx},'local',this.value)" /></td>
      <td><input class="txt" style="width:95px" value="${item.uc}" onchange="updateField(${idx},'uc',this.value)" /></td>
      <td>
        <select onchange="updateField(${idx},'mes',this.value)">
          ${MESES_LISTA.map(m => `<option value="${m}" ${item.mes===m?'selected':''}>${m}</option>`).join('')}
        </select>
      </td>
      <td><input style="width:55px" value="${item.ano}" onchange="updateField(${idx},'ano',this.value)" /></td>
      <td><input class="txt" style="width:90px" value="${item.periodo}" onchange="updateField(${idx},'periodo',this.value)" /></td>
      <td><input value="${item.demPontaKw}" onchange="updateField(${idx},'demPontaKw',this.value)" /></td>
      <td><input value="${item.demFpKw}" onchange="updateField(${idx},'demFpKw',this.value)" /></td>
      <td><input value="${item.demandaRs}" onchange="updateField(${idx},'demandaRs',this.value)" /></td>
      <td><input value="${item.consPontaKwh}" onchange="updateField(${idx},'consPontaKwh',this.value)" /></td>
      <td><input value="${item.consFpKwh}" onchange="updateField(${idx},'consFpKwh',this.value)" /></td>
      <td style="font-weight:600; text-align:right;">${item.consTotalKwh}</td>
      <td><input value="${item.consPontaRs}" onchange="updateField(${idx},'consPontaRs',this.value)" /></td>
      <td><input value="${item.consFpRs}" onchange="updateField(${idx},'consFpRs',this.value)" /></td>
      <td style="font-weight:600; text-align:right;">${item.consTotalRs.toFixed(2)}</td>
      <td><input value="${item.reativoRs}" onchange="updateField(${idx},'reativoRs',this.value)" /></td>
      <td><input value="${item.cipRs}" onchange="updateField(${idx},'cipRs',this.value)" /></td>
      <td><input value="${item.outrosRs}" onchange="updateField(${idx},'outrosRs',this.value)" /></td>
      <td><input value="${item.creditosRs}" onchange="updateField(${idx},'creditosRs',this.value)" /></td>
      <td><input style="font-weight:700; background:#f0fdf4;" value="${item.totalFatura}" onchange="updateField(${idx},'totalFatura',this.value)" /></td>
      <td><button class="btn btn-danger" onclick="removeRow(${idx})">X</button></td>
    </tr>
  `).join('');
}

