      ["Mês", "Ponta", "F.Ponta", "cional", "Ponta", "F.Ponta", "Total", "", "Ponta", "F.Ponta", "Total", "Ponta", "F.Ponta", "Total", "(R$)", "", "", "(R$)", "(R$)", "", "", "", "(R$)"]
