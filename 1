      [mesExtenso, ano, "", "", "", "", "", "PREFEITURA MUNICIPAL DE PORTO ALEGRE"],
      ["", "", "", "", "", "", "", "DEPARTAMENTO MUNICIPAL DE ÁGUA E ESGOTOS"],
      ["", "", "", "", "", "", "", "GERÊNCIA DE MANUTENÇÃO INDUSTRIAL"],
      [],
      ["", "", "", "", "Demanda - kW", "", "", "Demanda - (R$)", "", "", "Fator de", "Consumo - (kWh)", "", "", "Consumo - (R$)", "", "", "Reativo", "Período", "Ultrapas-", "Iluminação", "Multa por", "Bandeira", "Outros", "Créditos", "TOTAL DA"],
      ["LOCAL", "NÚMERO", "OPE", "MED", "Horosazonal", "", "Conven-", "Horosazonal", "", "", "Potência", "Horosazonal", "", "", "Horosazonal", "", "", "B.F.P.", "leitura", "sagem", "Pública", "atraso pagam.", "(R$)", "(R$)", "(R$)", "FATURA"],
      ["", "INSTALAÇÃO", "", "", "Ponta", "F. Ponta", "cional", "Ponta", "F. Ponta", "Total", "", "Ponta", "F. Ponta", "Total", "Ponta", "F. Ponta", "Total", "(R$)", "", "(R$)", "(R$)", "(R$)", "", "", "", "(R$)"]
    ];

    let currentSystem = "";
    STATIONS_CATALOG.forEach(st => {
      if (st.sistema !== currentSystem) {
        currentSystem = st.sistema;
        rows.push([]);
        rows.push([currentSystem]);
      }

      const inv = invoices.find(x =>
        (x.codigo === st.codigo || x.uc.replace(/\D/g,'') === st.uc_clean) &&
        x.mes === mesCod &&
        String(x.ano) === String(ano)
      ) || invoices.find(x =>
        (x.codigo === st.codigo || x.uc.replace(/\D/g,'') === st.uc_clean) &&
        x.mes === mesCod
      );

      if (inv) {
        rows.push([
          st.local,
          st.uc,
          st.ope,
          st.med,
          inv.demPontaKw || null,
          inv.demFpKw || null,
          inv.demConvKw || null,
          null,
          null,
          inv.demandaRs || null,
          null,
          inv.consPontaKwh || null,
          inv.consFpKwh || null,
          inv.consTotalKwh || null,
          inv.consPontaRs || null,
          inv.consFpRs || null,
          inv.consTotalRs || null,
          inv.reativoRs || null,
          inv.periodo || "",
          null,
          inv.cipRs || null,
          null,
          inv.bandeiraRs || null,
          inv.outrosRs || null,
          inv.creditosRs || null,
          inv.totalFatura || null
        ]);
      } else {
        rows.push([st.local, st.uc, st.ope, st.med]);
      }
    });

    // Adiciona eventuais faturas avulsas cujo código não estava no catálogo padrão
    const extraInvs = invoices.filter(inv =>
      inv.mes === mesCod &&
      !STATIONS_CATALOG.some(st => st.codigo === inv.codigo || st.uc_clean === inv.uc.replace(/\D/g,''))
    );
    if (extraInvs.length) {
      rows.push([]);
      rows.push(["OUTRAS ESTAÇÕES IMPORTADAS"]);
      extraInvs.forEach(inv => {
        rows.push([
          inv.local, inv.uc, "", "HV",
          inv.demPontaKw, inv.demFpKw, inv.demConvKw, null, null, inv.demandaRs, null,
          inv.consPontaKwh, inv.consFpKwh, inv.consTotalKwh,
          inv.consPontaRs, inv.consFpRs, inv.consTotalRs,
          inv.reativoRs, inv.periodo, null, inv.cipRs, null, inv.bandeiraRs, inv.outrosRs, inv.creditosRs, inv.totalFatura
        ]);
      });
    }

    const ws = XLSX.utils.aoa_to_sheet(rows);
    ws['!cols'] = [
      {wch:36},{wch:14},{wch:5},{wch:5},{wch:9},{wch:9},{wch:9},{wch:9},{wch:9},{wch:11},
      {wch:8},{wch:9},{wch:9},{wch:11},{wch:10},{wch:10},{wch:11},{wch:9},{wch:13},
      {wch:9},{wch:10},{wch:10},{wch:9},{wch:11},{wch:11},{wch:13}
    ];
    XLSX.utils.book_append_sheet(wb, ws, aba);
  });

  XLSX.writeFile(wb, `Custo_Mensal_${ano}.xlsx`);
}
</script>
</body>
