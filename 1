          inv.demFpKw || null,
          inv.demConvKw || 0,
          null,
          null,
          inv.demandaRs || null,
          null,
          inv.consPontaKwh || null,
          inv.consFpKwh || null,
          inv.consTotalKwh || 0,
          inv.consPontaRs || null,
          inv.consFpRs || null,
          inv.consTotalRs || 0,
          inv.reativoRs || null,
          inv.periodo || "",
          null,
          inv.cipRs || null,
          null,
          inv.bandeiraRs || null,
          inv.outrosRs || null,
          inv.creditosRs || null,
          inv.totalFatura || 0
        ]);
      } else {
        rows.push([m, null, null, 0, null, null, null, null, null, null, 0, null, null, 0, null, "", null, null, null, null, null, null, 0]);
      }
    });

    const endRowExcel = startRowExcel + 11; // Linha 25
    // Linhas de resumo: MÁXIMO, MÉDIA, TOTAL/ANO
    const colsLetters = ["B","C","D","E","F","G","H","I","J","K","L","M","N","O","Q","R","S","T","U","V","W"];
    const rowMax = ["MÁXIMO"];
    const rowAvg = ["MÉDIA"];
    const rowSum = ["TOTAL/ANO"];

    for (let c = 1; c <= 22; c++) {
      if (c === 15) { // Coluna P (Período leitura)
        rowMax.push(""); rowAvg.push(""); rowSum.push("");
        continue;
      }
      const colLet = XLSX.utils.encode_col(c);
      rowMax.push({ f: `MAX(${colLet}${startRowExcel}:${colLet}${endRowExcel})` });
      rowAvg.push({ f: `AVERAGE(${colLet}${startRowExcel}:${colLet}${endRowExcel})` });
      rowSum.push({ f: `SUM(${colLet}${startRowExcel}:${colLet}${endRowExcel})` });
    }
    rows.push(rowMax, rowAvg, rowSum);

    const ws = XLSX.utils.aoa_to_sheet(rows);
    ws['!cols'] = [
      {wch:12},{wch:9},{wch:9},{wch:9},{wch:9},{wch:9},{wch:11},{wch:8},
