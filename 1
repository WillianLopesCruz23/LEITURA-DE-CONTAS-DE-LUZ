  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <style>
    :root {
      --primary: #0b4f8a;
      --primary-dark: #073763;
      --accent: #00897b;
      --bg: #f3f6fa;
      --card: #ffffff;
      --border: #d8e1eb;
      --text: #1e293b;
      --muted: #64748b;
    }
    * { box-sizing: border-box; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    body { margin: 0; background: var(--bg); color: var(--text); }
    header {
      background: linear-gradient(135deg, var(--primary-dark), var(--primary));
      color: #fff;
      padding: 20px 32px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.12);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    header h1 { margin: 0; font-size: 1.35rem; font-weight: 600; }
    header p { margin: 4px 0 0; font-size: 0.88rem; opacity: 0.9; }
    .container { max-width: 1440px; margin: 24px auto; padding: 0 20px; }
    .grid-top { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 20px; }
    @media (max-width: 960px) { .grid-top { grid-template-columns: 1fr; } }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    .card h2 { margin: 0 0 12px; font-size: 1.05rem; color: var(--primary-dark); }
    .dropzone {
      border: 2px dashed #7aa7d2;
      background: #f8fbff;
      border-radius: 8px;
      padding: 32px 20px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .dropzone:hover, .dropzone.dragover {
      background: #e8f2fc;
      border-color: var(--primary);
    }
    .dropzone strong { display: block; font-size: 1.05rem; color: var(--primary); margin-bottom: 6px; }
    .dropzone span { font-size: 0.85rem; color: var(--muted); }
    .controls { display: flex; flex-direction: column; gap: 12px; }
    .field-row { display: flex; gap: 10px; align-items: center; }
    .field-row label { font-size: 0.88rem; font-weight: 600; min-width: 110px; }
    .field-row input, .field-row select {
      flex: 1; padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.92rem;
    }
    .btn {
      border: none; border-radius: 6px; padding: 11px 16px; font-size: 0.92rem; font-weight: 600;
      cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      transition: background 0.15s;
    }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-dark); }
    .btn-accent { background: var(--accent); color: #fff; }
    .btn-accent:hover { background: #00695c; }
    .btn-danger { background: #dc2626; color: #fff; padding: 5px 9px; font-size: 0.8rem; }
    .btn-outline { background: #fff; border: 1px solid var(--border); color: var(--text); }
    .btn-outline:hover { background: #f1f5f9; }
    .stats-bar {
      display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;
      font-size: 0.88rem; color: var(--muted);
    }
    .badge {
      background: #e2e8f0; color: #1e293b; padding: 4px 10px; border-radius: 20px; font-weight: 600;
    }
    .badge.ok { background: #dcfce7; color: #166534; }
    .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; }
    table { width: 100%; border-collapse: collapse; font-size: 0.82rem; white-space: nowrap; }
    th {
      background: #eaf1f8; color: var(--primary-dark); font-weight: 600;
      padding: 9px 8px; border-bottom: 1px solid var(--border); text-align: left;
    }
    td { padding: 6px 8px; border-bottom: 1px solid #eef2f6; }
    tr:hover td { background: #f8fafc; }
    td input {
      width: 82px; padding: 4px 6px; border: 1px solid #cbd5e1; border-radius: 4px;
      font-size: 0.82rem; text-align: right;
    }
    td input.txt { width: 110px; text-align: left; }
    td input.code { width: 65px; text-align: center; font-weight: 600; }
    .log-box {
      margin-top: 12px; font-size: 0.82rem; color: var(--muted);
      max-height: 90px; overflow-y: auto; background: #f8fafc; padding: 8px 12px; border-radius: 6px;
    }
  </style>
</head>
<body>

<header>
  <div>
    <h1>DMAE — Leitor Automático de Contas de Energia (CEEE Equatorial)</h1>
    <p>Importe os PDFs das faturas, confira os dados extraídos e baixe as duas planilhas preenchidas.</p>
  </div>
  <div style="display:flex; gap:10px; flex-wrap:wrap;">
    <button class="btn btn-accent" onclick="downloadConsEn()">⬇ Baixar ConsEn HV (Por Estação)</button>
    <button class="btn btn-primary" onclick="downloadCustoMensal()">⬇ Baixar Custo Mensal (Por Mês)</button>
  </div>
</header>

<div class="container">
  <div class="grid-top">
    <div class="card">
      <h2>1. Anexar Contas de Luz (PDF)</h2>
      <div class="dropzone" id="dropzone" onclick="document.getElementById('fileInput').click()">
        <strong>Clique aqui ou arraste os arquivos PDF das faturas</strong>
        <span>Suporta múltiplos arquivos simultaneamente (ex.: 6102-out25.pdf, 100-out25.pdf...)</span>
        <input type="file" id="fileInput" accept="application/pdf" multiple style="display:none" />
      </div>
      <div class="log-box" id="logBox">Aguardando arquivos PDF...</div>
    </div>

    <div class="card">
      <h2>2. Configurações das Planilhas</h2>
      <div class="controls">
        <div class="field-row">
          <label for="anoRef">Ano de Referência:</label>
          <input type="number" id="anoRef" value="2025" min="2020" max="2035" />
        </div>
        <div class="field-row">
          <label for="filtroMes">Filtrar Tabela:</label>
          <select id="filtroMes" onchange="renderTable()">
            <option value="TODOS">Todos os meses carregados</option>
            <option value="JAN">Janeiro</option><option value="FEV">Fevereiro</option>
            <option value="MAR">Março</option><option value="ABR">Abril</option>
            <option value="MAIO">Maio</option><option value="JUN">Junho</option>
            <option value="JUL">Julho</option><option value="AGO">Agosto</option>
            <option value="SET">Setembro</option><option value="OUT">Outubro</option>
            <option value="NOV">Novembro</option><option value="DEZ">Dezembro</option>
          </select>
        </div>
        <div style="display:flex; gap:8px; margin-top:4px;">
          <button class="btn btn-outline" style="flex:1" onclick="clearAll()">Limpar Lista</button>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
      <h2 style="margin:0;">3. Faturas Extraídas (Editável antes do Download)</h2>
      <div class="stats-bar" style="margin:0;">
        <span class="badge ok" id="countBadge">0 faturas carregadas</span>
        <span class="badge" id="totalBadge">Total Geral: R$ 0,00</span>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Arquivo</th>
            <th>Cód.</th>
            <th>Estação / Local</th>
            <th>UC</th>
            <th>Mês</th>
            <th>Ano</th>
            <th>Período</th>
            <th>Dem. Ponta (kW)</th>
            <th>Dem. F.Ponta (kW)</th>
            <th>Demanda (R$)</th>
            <th>Cons. Ponta (kWh)</th>
            <th>Cons. F.Ponta (kWh)</th>
            <th>Cons. Total (kWh)</th>
            <th>Cons. Ponta (R$)</th>
            <th>Cons. F.Ponta (R$)</th>
            <th>Cons. Total (R$)</th>
            <th>Reativo (R$)</th>
            <th>Ilum. Púb. (R$)</th>
            <th>Outros / Subv. (R$)</th>
            <th>Créditos (R$)</th>
            <th>TOTAL FATURA (R$)</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody id="tbody">
          <tr><td colspan="22" style="text-align:center; padding:24px; color:#64748b;">Nenhuma conta importada ainda.</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

